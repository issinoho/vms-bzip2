Subject: bzlib.h: on OpenVMS, declare the API with the library's /NAMES

The library is compiled with /NAMES=(AS_IS,SHORTENED), as the family of
ports is.  A program compiled with VSI C's default /NAMES=UPPERCASE would
look for BZ2_BZCOMPRESSINIT and not find BZ2_bzCompressInit.  Declare the
API under #pragma names as_is, shortened on VMS, so programs compiled with
any /NAMES link with the library (as vms-zlib does for zlib.h).

--- a/bzlib.h	2026-10-05 10:48:22.516303613 +0100
+++ b/bzlib.h	2026-10-05 10:48:37.975622712 +0100
@@ -22,6 +22,13 @@
 #ifndef _BZLIB_H
 #define _BZLIB_H
 
+#ifdef __VMS
+/* The library is compiled with /NAMES=(AS_IS,SHORTENED); declare its API
+   so, whatever /NAMES the program is compiled with.  */
+# pragma names save
+# pragma names as_is, shortened
+#endif
+
 #ifdef __cplusplus
 extern "C" {
 #endif
@@ -275,6 +282,10 @@
 }
 #endif
 
+#ifdef __VMS
+# pragma names restore
+#endif
+
 #endif
 
 /*-------------------------------------------------------------*/
