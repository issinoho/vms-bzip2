       case SM_F2O:
-         inStr = fopen ( inName, "rb" );
+         inStr = fopen ( inName, COMPRESS_INPUT_MODE ( inName ) );
          outStr = stdout;
          if ( isatty ( fileno ( stdout ) ) ) {
             fprintf ( stderr,
@@ -1270,7 +1289,7 @@
